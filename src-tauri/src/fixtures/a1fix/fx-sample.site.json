    },
    "bpbtn": {
      "id": "bpbtn",
      "props": {
        "action": "link",
        "href": "/about",
        "label": "ปุ่มสอง",
        "type": "button"
      },
      "states": {
        "active": {
          "backgroundColor": "#115e59",
          "backgroundGradient": {
            "angle": 180.0,
            "kind": "linear",
            "stops": [
              {
                "at": 0.0,
                "color": "#115e59"
              },
              {
                "at": 100.0,
                "color": "#0f766e"
              }
            ]
          },
          "borderColor": "#134e4a"
        },
        "focusVisible": {
          "boxShadow": [
            {
              "blur": 0.0,
              "color": "#0077c2",
              "spread": 3.0,
              "x": 0.0,
              "y": 0.0
            }
          ]
        },
        "hover": {
          "color": "#fef08a",
          "filter": {
            "brightness": 110.0
          },
          "opacity": 0.95
        }
      },
      "style": {
        "backgroundColor": "#0f766e",
        "color": "#ffffff",
        "cursor": "pointer",
        "padding": 12.0
      },
      "styleBreakpoints": {
        "tablet": {
          "padding": 8.0
        }
      },
      "type": "button"
    },
    "btn": {
      "id": "btn",
      "props": {
