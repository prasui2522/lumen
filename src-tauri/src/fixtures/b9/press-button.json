{
  "version": 2,
  "meta": { "title": "b9-press", "lang": "th" },
  "root": "root",
  "nodes": {
    "root": {
      "id": "root",
      "type": "page",
      "props": { "type": "page", "children": ["btn"] },
      "style": {}
    },
    "btn": {
      "id": "btn",
      "type": "button",
      "props": {
        "type": "button",
        "label": "กด",
        "href": "https://example.com",
        "action": "link"
      },
      "style": {
        "boxShadow": [
          { "x": 0, "y": 6, "blur": 0, "spread": 0, "color": "#0369a1" },
          { "x": 0, "y": 10, "blur": 12, "spread": 0, "color": "#00000033" }
        ],
        "transition": {
          "durationMs": 120,
          "delayMs": 0,
          "easing": "ease-out",
          "property": "paint"
        }
      },
      "states": {
        "hover": {
          "backgroundColor": "#38bdf8",
          "transform": { "translateY": -1 }
        },
        "active": {
          "transform": { "translateY": 5 },
          "boxShadow": [
            { "x": 0, "y": 1, "blur": 0, "spread": 0, "color": "#0369a1" },
            { "x": 0, "y": 2, "blur": 4, "spread": 0, "color": "#00000033" }
          ]
        }
      }
    }
  }
}
