{
  "version": 1,
  "meta": { "title": "ร้านกาแฟ", "description": "หน้าแรก", "lang": "th", "favicon": { "id": "fav-1", "alt": "icon" } },
  "root": "page",
  "nodes": {
    "page": { "id": "page", "type": "page", "name": "Page",
      "props": { "type": "page", "children": ["hero", "hidden"] },
      "style": { "backgroundColor": "#f8fafc", "fontFamily": "Georgia, serif" } },
    "hero": { "id": "hero", "type": "section", "name": "Hero", "classNames": ["hero", "dark"],
      "props": { "type": "section", "children": ["h1", "h3", "h6", "intro", "row"] },
      "style": { "backgroundColor": "#0f172a", "color": "#ffffff",
                 "padding": { "t": 48, "r": 24, "b": 48, "l": 24 },
                 "borderWidth": 2, "borderStyle": "solid", "borderColor": "#0ea5e9",
                 "borderRadius": 16, "maxWidth": 960, "minHeight": "50vh", "overflow": "hidden" } },
    "h1": { "id": "h1", "type": "heading", "props": { "type": "heading", "level": 1, "content": "กาแฟดี" },
      "style": { "color": "#ffffff", "textAlign": "center" } },
    "h3": { "id": "h3", "type": "heading", "locked": true,
      "props": { "type": "heading", "level": 3, "content": "คั่วสด" }, "style": {} },
    "h6": { "id": "h6", "type": "heading",
      "props": { "type": "heading", "level": 6, "content": "เล็ก" }, "style": { "fontSize": 12 } },
    "intro": { "id": "intro", "type": "text", "props": { "type": "text", "content": "เปิดทุกวัน" },
      "style": { "fontWeight": "bold", "lineHeight": 1.8, "margin": { "b": 16 }, "opacity": 0.9 } },
    "row": { "id": "row", "type": "container",
      "props": { "type": "container", "children": ["cta", "more", "inner"],
                 "direction": "row", "gap": 16, "align": "center", "justify": "between" },
      "style": { "width": "100%", "height": 80, "display": "block" } },
    "cta": { "id": "cta", "type": "button",
      "props": { "type": "button", "label": "สั่งเลย", "href": "https://shop.example/order", "action": "link" },
      "style": { "backgroundColor": "#e11d48", "padding": 12 } },
    "more": { "id": "more", "type": "link",
      "props": { "type": "link", "label": "เมนู", "href": "https://example.com/menu", "openInNewTab": true },
      "style": { "fontSize": 18 } },
    "inner": { "id": "inner", "type": "container",
      "props": { "type": "container", "children": ["pic", "nopic", "gap", "same"] },
      "style": {} },
    "pic": { "id": "pic", "type": "image",
      "props": { "type": "image", "src": { "id": "beans.jpg", "alt": "เมล็ดกาแฟ" }, "objectFit": "contain" },
      "style": { "width": 240, "borderRadius": 8 } },
    "nopic": { "id": "nopic", "type": "image",
      "props": { "type": "image", "src": { "id": "" }, "objectFit": "fill" }, "style": {} },
    "gap": { "id": "gap", "type": "spacer", "props": { "type": "spacer", "size": 40 }, "style": {} },
    "same": { "id": "same", "type": "link",
      "props": { "type": "link", "label": "ที่ตั้ง", "href": "/map", "openInNewTab": false }, "style": {} },
    "hidden": { "id": "hidden", "type": "text", "visible": false,
      "props": { "type": "text", "content": "SECRET" }, "style": {} }
  }
}
