{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Web Builder",
  "version": "0.1.1",
  "identifier": "com.webapp.builder",
  "build": {
    "beforeDevCommand": "bun scripts/ensure-bundled-bun.mjs && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/ensure-bundled-bun.mjs && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Web Builder",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "resources/bin/bun": "bin/bun"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1ODMzMUFDODU3MEQ4NTgKUldSWTJIQ0ZyREdEeGZrOTJORk8xZEFFbTExMUVFb2VzODdXRGFFb0wrVzk3bFgyRHNGMXVkNUkK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ]
    }
  }
}
